require "option_parser"
require "socket"

custom_port = nil
command_args = [] of String

OptionParser.parse(ARGV) do |parser|
  parser.banner = "Usage: box [options] [command] [args]"
  parser.on("-C PORT", "--port PORT", "Custom port") { |p| custom_port = p.to_i }
  parser.on("-h", "--help", "Show help") { puts parser; exit }
  parser.invalid_option { |arg| command_args << arg }
end

def find_daemon_port(custom : Int32?, target_port : Int32)
  return custom if custom
  begin
    socket = TCPSocket.new("127.0.0.1", target_port)
    socket.close
    return target_port
  rescue
  end
  target_port
end

# Check if user is trying to talk to networkd via 'net' or 'network'
is_net_cmd = false
if ARGV[0]? == "net" || ARGV[0]? == "network"
  is_net_cmd = true
  ARGV.shift # Remove 'net' keyword before forwarding arguments to networkd
end

target_default_port = is_net_cmd ? 210 : 209
port = find_daemon_port(custom_port, target_default_port)
full_command = ARGV.join(" ")

if full_command.empty?
  STDERR.puts "\033[31m[FAIL]\033[0m No command provided. Try 'box list' or 'box net help'."
  exit 1
end

begin
  socket = TCPSocket.new("127.0.0.1", port)
  socket.puts(full_command)
  while response = socket.gets
    puts response
  end
  socket.close
rescue ex
  daemon_name = is_net_cmd ? "NetworkD" : "BoxD"
  STDERR.puts "\033[31m[FAIL]\033[0m Could not connect to #{daemon_name} daemon on port \033[34m#{port}\033[0m. Is it running?"
  exit 1
end
